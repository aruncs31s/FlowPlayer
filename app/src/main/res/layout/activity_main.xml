<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/bg_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_main_ip_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_yellow"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="IP: --"
            android:textColor="@color/yellow_primary"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_top_device_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Listening Device"
            android:padding="8dp"
            android:src="@drawable/ic_phone_android"
            app:tint="@color/yellow_primary" />

        <ImageButton
            android:id="@+id/btn_main_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_dark"
            app:backgroundTint="@null"
            android:contentDescription="Settings &amp; About"
            android:padding="8dp"
            android:src="@drawable/ic_info"
            app:tint="@color/yellow_primary" />
    </LinearLayout>

    <View
        android:id="@+id/divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/layout_top_bar"
        android:background="@color/card_stroke" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_dark"
        android:orientation="horizontal">

        <!-- Tab 1: Sync -->
        <LinearLayout
            android:id="@+id/nav_tab_sync"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_tab_sync"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_sync"
                android:src="@drawable/ic_sync"
                android:tint="@color/yellow_primary" />

            <TextView
                android:id="@+id/tv_tab_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_sync"
                android:textColor="@color/yellow_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Library -->
        <LinearLayout
            android:id="@+id/nav_tab_library"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_tab_library"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_library"
                android:src="@drawable/ic_library"
                android:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_tab_library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_library"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Player (Main Player Screen) -->
        <LinearLayout
            android:id="@+id/nav_tab_player"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_tab_player"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_player"
                android:src="@drawable/ic_album"
                android:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_tab_player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_player"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Playlists -->
        <LinearLayout
            android:id="@+id/nav_tab_playlists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_tab_playlists"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Playlists"
                android:src="@drawable/ic_queue_music"
                android:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_tab_playlists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Playlists"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Logs -->
        <LinearLayout
            android:id="@+id/nav_tab_logs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_tab_logs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_logs"
                android:src="@drawable/ic_terminal"
                android:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_tab_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_logs"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/layout_bottom_nav"
        android:background="@color/card_stroke" />

    <!-- Sticky Audio Player Bar -->
    <include
        android:id="@+id/player_bar_container"
        layout="@layout/view_player_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/divider_bottom" />

    <!-- ViewPager2 for Swipe Navigation -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/divider_top"
        android:layout_above="@id/player_bar_container" />

</RelativeLayout>
