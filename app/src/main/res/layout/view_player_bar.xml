<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_bar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Shuffle Button -->
        <ImageButton
            android:id="@+id/btn_player_shuffle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Shuffle"
            android:padding="5dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/text_muted" />

        <!-- Previous Track Button -->
        <ImageButton
            android:id="@+id/btn_player_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Track"
            android:padding="5dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/text_primary" />

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/btn_player_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_yellow"
            android:contentDescription="Play/Pause"
            android:src="@drawable/ic_play" />

        <!-- Next Track Button -->
        <ImageButton
            android:id="@+id/btn_player_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Track"
            android:padding="5dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary" />

        <!-- Repeat Button -->
        <ImageButton
            android:id="@+id/btn_player_repeat"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Repeat"
            android:padding="5dp"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_muted" />

        <!-- Title and Artist (Tappable to expand to Main Player Screen) -->
        <LinearLayout
            android:id="@+id/layout_player_track_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tv_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Song Title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_player_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artist Name"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Like Button -->
        <ImageButton
            android:id="@+id/btn_player_like"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like Song"
            android:padding="5dp"
            android:src="@drawable/ic_favorite_border"
            android:tint="@color/text_muted" />

        <!-- Queue Button -->
        <ImageButton
            android:id="@+id/btn_player_queue"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Current Queue"
            android:padding="5dp"
            android:src="@drawable/ic_queue_music"
            android:tint="@color/yellow_primary" />

        <!-- Close Player Button -->
        <ImageButton
            android:id="@+id/btn_player_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Player"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@+id/player_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="@color/yellow_primary"
            android:thumbTint="@color/yellow_primary" />

        <TextView
            android:id="@+id/tv_player_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="00:00 / 00:00"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
