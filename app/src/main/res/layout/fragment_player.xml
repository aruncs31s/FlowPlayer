<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">



    <!-- CONTENT CONTAINER (Holds Empty/Idle State and Active Player Content) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. EMPTY / IDLE STATE -->
        <LinearLayout
            android:id="@+id/layout_fp_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_fp_empty_icon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_album"
                app:tint="@color/card_stroke" />

            <TextView
                android:id="@+id/tv_fp_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="No Track Playing"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fp_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Choose a track from your Library or Playlists to start listening."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <!-- Remote idle actions container -->
            <LinearLayout
                android:id="@+id/layout_fp_empty_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Resume Remote Playback Button -->
                <TextView
                    android:id="@+id/btn_fp_empty_resume_remote"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Resume Playback on Device"
                    android:textColor="@color/bg_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Cast / Transfer Current Track Button -->
                <TextView
                    android:id="@+id/btn_fp_empty_transfer_here"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Cast Current Song to Device"
                    android:textColor="@color/yellow_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Browse Music Library Button -->
                <TextView
                    android:id="@+id/btn_fp_empty_browse"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Browse Music Library"
                    android:textColor="@color/bg_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Switch Back to This Device Button -->
                <TextView
                    android:id="@+id/btn_fp_empty_switch_local"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Switch to This Device (Phone)"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. ACTIVE PLAYER CONTENT: Shown when a track is playing/loaded -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_fp_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Top Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.06"
                            android:text="NOW PLAYING"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_fp_queue_pos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Track 1 of 1"
                            android:textColor="@color/yellow_primary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_fp_device_switch"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Switch Device"
                        android:padding="7dp"
                        android:src="@drawable/ic_computer"
                        android:tint="@color/yellow_primary" />

                    <ImageButton
                        android:id="@+id/btn_fp_info"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Audio Info / Tags"
                        android:padding="7dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/yellow_primary" />

                    <ImageButton
                        android:id="@+id/btn_fp_queue_toggle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Playback Queue"
                        android:padding="7dp"
                        android:src="@drawable/ic_queue_music"
                        android:tint="@color/text_primary" />
                </LinearLayout>

                <!-- Album Art / Vinyl Display Card -->
                <FrameLayout
                    android:id="@+id/layout_fp_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_fp_artwork"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_album"
                        android:tint="@color/card_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_badge_yellow"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:text="Tap screen for Audio Info &amp; Tags"
                        android:textColor="@color/yellow_primary"
                        android:textSize="11sp" />
                </FrameLayout>

                <!-- Song Info Block -->
                <LinearLayout
                    android:id="@+id/layout_fp_song_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tv_fp_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Song Title"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_fp_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="Artist Name"
                        android:textColor="@color/yellow_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_fp_album"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="Album Name"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Audio Specs Badge Chips -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_fp_badge_format"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_yellow"
                            android:fontFamily="monospace"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="MP3"
                            android:textColor="@color/yellow_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_fp_badge_bitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_button_dark"
                            android:fontFamily="monospace"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="320k"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_fp_badge_samplerate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_button_dark"
                            android:fontFamily="monospace"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="44.1kHz"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_fp_badge_source"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_green"
                            android:fontFamily="monospace"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="LOCAL"
                            android:textColor="@color/status_online"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Seekbar & Time Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <SeekBar
                        android:id="@+id/fp_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1000"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressTint="@color/yellow_primary"
                        android:thumbTint="@color/yellow_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_fp_current_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="00:00"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_fp_total_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="00:00"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Main Playback Controls Cluster -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Shuffle -->
                    <ImageButton
                        android:id="@+id/btn_fp_shuffle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Shuffle"
                        android:padding="10dp"
                        android:src="@drawable/ic_shuffle"
                        android:tint="@color/text_muted" />

                    <!-- Previous -->
                    <ImageButton
                        android:id="@+id/btn_fp_prev"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="14dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous"
                        android:padding="12dp"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/text_primary" />

                    <!-- Play/Pause (Large Yellow Button) -->
                    <ImageButton
                        android:id="@+id/btn_fp_play_pause"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_button_yellow"
                        android:contentDescription="Play/Pause"
                        android:padding="16dp"
                        android:src="@drawable/ic_play" />

                    <!-- Next -->
                    <ImageButton
                        android:id="@+id/btn_fp_next"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="14dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next"
                        android:padding="12dp"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_primary" />

                    <!-- Repeat -->
                    <ImageButton
                        android:id="@+id/btn_fp_repeat"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Repeat"
                        android:padding="10dp"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/text_muted" />
                </LinearLayout>

                <!-- Bottom Actions Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Like / Favorite Button -->
                    <ImageButton
                        android:id="@+id/btn_fp_like"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Like Song"
                        android:padding="8dp"
                        android:src="@drawable/ic_favorite_border"
                        android:tint="@color/text_muted" />

                    <!-- Add to Playlist Button -->
                    <ImageButton
                        android:id="@+id/btn_fp_add_playlist"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Add to Playlist"
                        android:padding="8dp"
                        android:src="@drawable/ic_playlist_add"
                        android:tint="@color/yellow_primary" />

                    <!-- Download to Device Button (visible only when playing Over-IP) -->
                    <ImageButton
                        android:id="@+id/btn_fp_download"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Download to Device"
                        android:padding="8dp"
                        android:src="@drawable/ic_download"
                        android:tint="@color/text_primary"
                        android:visibility="gone" />

                    <!-- Play on This Phone Button (visible when playing on remote device) -->
                    <TextView
                        android:id="@+id/btn_fp_transfer_local"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_yellow"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Play on Phone"
                        android:textColor="@color/yellow_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Song Info / Audio Tags Button -->
                    <TextView
                        android:id="@+id/btn_fp_audio_info"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Audio Info / Tags"
                        android:textColor="@color/yellow_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Song Options Menu -->
                    <ImageButton
                        android:id="@+id/btn_fp_options"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Song Options"
                        android:padding="8dp"
                        android:src="@drawable/ic_terminal"
                        android:tint="@color/text_muted" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/card_stroke" />

                <!-- Up Next / Queue Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="UP NEXT IN QUEUE"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_fp_queue_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_yellow"
                        android:fontFamily="monospace"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="0 tracks"
                        android:textColor="@color/yellow_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fp_queue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

</LinearLayout>
